<section id="{{ componentId }}" class="component lb-product-page" data-component-id="{{ componentId }}">
  <div class="lb-product-layout">
    <!-- Images -->
    <div class="lb-product-images">
      {% if product.image_urls | length > 1 %}
      <div class="splide lb-splide" id="product-splide">
        <div class="splide__track">
          <ul class="splide__list">
            {% for img in product.image_urls %}
            <li class="splide__slide">
              <img src="{{ img }}" alt="{{ product.name }}" class="lb-product-main-image" style="aspect-ratio: var(--product-page-image-aspect-ratio); object-fit: var(--product-image-fit);" />
            </li>
            {% endfor %}
          </ul>
        </div>
      </div>
      <script>
        document.addEventListener('DOMContentLoaded', function () {
          new Splide('#product-splide', { type: 'loop', pagination: true, arrows: true }).mount();
        });
      </script>
      {% elif product.image_urls | length == 1 %}
        <img src="{{ product.image_urls[0] }}" alt="{{ product.name }}" class="lb-product-main-image" style="aspect-ratio: var(--product-page-image-aspect-ratio); object-fit: var(--product-image-fit);" />
      {% elif product.image_url %}
        <img src="{{ product.image_url }}" alt="{{ product.name }}" class="lb-product-main-image" style="aspect-ratio: var(--product-page-image-aspect-ratio); object-fit: var(--product-image-fit);" />
      {% endif %}
    </div>

    <!-- Details -->
    <div class="lb-product-details">
      <div class="lb-product-badges-top">
        {% for badge in product.product_badges.page %}
        <span class="lb-badge" style="background-color: {{ badge.color }}">
          {% if badge.icon %}<i class="{{ badge.icon }} fa-fw"></i>{% endif %}
          {{ badge.label }}
        </span>
        {% endfor %}
      </div>

      <h1 class="lb-product-title">{{ product.name }}</h1>

      {% if product.average_rating %}
      <div class="lb-product-rating">
        {% for i in range(product.average_rating | round) %}★{% endfor %}
        <span class="lb-rating-count">({{ product.total_feedbacks }} reviews)</span>
      </div>
      {% endif %}

      <div class="lb-product-price-block">
        <span class="lb-product-price">
          {% if product.min_price != product.max_price %}
            <span x-text="appCurrency.format({{ product.min_price }}, '{{ product.currency }}')">{{ formatPrice(product.min_price, product.currency) }}</span>
            &ndash;
            <span x-text="appCurrency.format({{ product.max_price }}, '{{ product.currency }}')">{{ formatPrice(product.max_price, product.currency) }}</span>
          {% elif product.min_price %}
            <span x-text="appCurrency.format({{ product.min_price }}, '{{ product.currency }}')">{{ formatPrice(product.min_price, product.currency) }}</span>
          {% endif %}
        </span>
        {% if product.min_price_slash %}
        <span class="lb-price-slash">
          <span x-text="appCurrency.format({{ product.min_price_slash }}, '{{ product.currency }}')">{{ formatPrice(product.min_price_slash, product.currency) }}</span>
        </span>
        {% endif %}
      </div>

      {% render_snippet "product-form.njk", product=product, properties=properties %}
    </div>
  </div>

  {% if product.description %}
  <div class="lb-product-desc-section">
    <h2 class="lb-section-title">Description</h2>
    <div class="lb-section-line"></div>
    <div class="lb-prose lb-product-description">{{ product.description | safe }}</div>
  </div>
  {% endif %}

  {% if product.feedbacks | length > 0 %}
  <div class="lb-product-reviews-section">
    <h2 class="lb-section-title">Reviews</h2>
    <div class="lb-section-line"></div>
    <div class="lb-feedbacks-grid">
      {% for feedback in product.feedbacks %}
        {% render_snippet "feedback-card.njk", feedback=feedback %}
      {% endfor %}
    </div>
  </div>
  {% endif %}
</section>
