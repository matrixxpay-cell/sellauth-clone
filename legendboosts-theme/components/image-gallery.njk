<section id="{{ componentId }}" class="component lb-gallery-section" data-component-id="{{ componentId }}">
  {% if properties.title %}
  <div class="lb-section-header">
    <h2 class="lb-section-title">{{ properties.title | renderString }}</h2>
    <div class="lb-section-line"></div>
  </div>
  {% endif %}
  <div class="lb-gallery-grid lb-gallery-cols-{{ properties.items_per_row or 2 }}">
    {% for image in properties.images %}
    <div class="lb-gallery-item">
      <img src="{{ image }}" alt="" class="lb-gallery-img" style="aspect-ratio:{{ properties.aspect_ratio if properties.aspect_ratio and properties.aspect_ratio != 'Default' else '16/9' }};object-fit:cover;" loading="lazy" />
    </div>
    {% endfor %}
  </div>
</section>
