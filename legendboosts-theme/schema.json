{
  "global": {
    "properties": {
      "accent_color": {
        "label": "Accent Color",
        "type": "color"
      },
      "background_color": {
        "label": "Background Color",
        "type": "color"
      },
      "card_color": {
        "label": "Card Background Color",
        "type": "color"
      },
      "text_primary_color": {
        "label": "Primary Text Color",
        "type": "color",
        "default": "#ffffff"
      },
      "text_accent_color": {
        "label": "Accent Text Color",
        "type": "color",
        "default": "#ffffff"
      },
      "font": {
        "label": "Font Family",
        "type": "text",
        "default": "Inter",
        "datalist": ["Inter", "Poppins", "Nunito", "Rajdhani", "Orbitron"]
      },
      "product_card_image_aspect_ratio": {
        "label": "Product Card Image Aspect Ratio",
        "type": "text",
        "default": "16/9",
        "datalist": ["1/1", "4/3", "16/9"]
      },
      "product_page_image_aspect_ratio": {
        "label": "Product Page Image Aspect Ratio",
        "type": "text",
        "default": "16/9",
        "datalist": ["1/1", "4/3", "16/9"]
      },
      "product_image_fit": {
        "label": "Product Image Fit",
        "type": "select",
        "options": ["scale-down", "cover"],
        "default": "cover"
      },
      "group_card_image_aspect_ratio": {
        "label": "Group Card Image Aspect Ratio",
        "type": "text",
        "default": "16/9",
        "datalist": ["1/1", "4/3", "16/9"]
      },
      "group_image_fit": {
        "label": "Group Image Fit",
        "type": "select",
        "options": ["scale-down", "cover"],
        "default": "cover"
      },
      "blog_card_image_aspect_ratio": {
        "label": "Blog Card Image Aspect Ratio",
        "type": "text",
        "default": "16/9",
        "datalist": ["1/1", "4/3", "16/9"]
      },
      "blog_image_fit": {
        "label": "Blog Image Fit",
        "type": "select",
        "options": ["scale-down", "cover"],
        "default": "cover"
      }
    }
  },
  "components": {
    "announcement": {
      "label": "Announcement",
      "global": true,
      "order": 0,
      "properties": {
        "announcements": {
          "label": "Announcements",
          "type": "list",
          "maxItems": 10,
          "properties": {
            "text": { "label": "Text", "type": "text", "default": "New Announcement" },
            "link": { "label": "Link", "type": "text", "default": null },
            "new_tab": { "label": "Open in New Tab", "type": "toggle", "default": false }
          }
        }
      }
    },
    "header": {
      "label": "Header",
      "global": true,
      "order": 1,
      "properties": {
        "show_shop_name": { "label": "Show Shop Name", "type": "toggle", "default": true },
        "show_logo": { "label": "Show Logo", "type": "toggle", "default": true },
        "show_description": { "label": "Show Description", "type": "toggle", "default": false },
        "show_stats": { "label": "Show Stats Bar", "type": "toggle", "default": true },
        "hide_currency_selector": { "label": "Hide Currency Selector", "type": "toggle", "default": false },
        "hide_customer_dashboard": { "label": "Hide Login / My Account", "type": "toggle", "default": false },
        "hide_cart": { "label": "Hide Cart", "type": "toggle", "default": false },
        "links": {
          "label": "Links",
          "type": "list",
          "maxItems": 10,
          "properties": {
            "text": { "label": "Text", "type": "text", "default": "New Link" },
            "link": { "label": "Link", "type": "text", "default": "#" },
            "new_tab": { "label": "Open in New Tab", "type": "toggle", "default": false }
          },
          "default": [
            { "text": "Home", "link": "/" },
            { "text": "Products", "link": "/products" },
            { "text": "Reviews", "link": "/feedback" },
            { "text": "FAQ", "link": "/faq" },
            { "text": "Status", "link": "/status" }
          ]
        }
      }
    },
    "products": {
      "label": "Products",
      "multiple": true,
      "properties": {
        "title": { "label": "Title", "type": "text", "default": "Shop" },
        "ids": { "label": "Handpick Products and Groups (optional)", "type": "products_and_groups", "default": [] },
        "show_searchbar": { "label": "Show Searchbar", "type": "toggle", "default": true },
        "centered": { "label": "Center Products", "type": "toggle", "default": false }
      }
    },
    "feedbacks": {
      "label": "Feedbacks",
      "multiple": true,
      "properties": {
        "title": { "label": "Title", "type": "text", "default": "Customer Reviews" },
        "amount": { "label": "Amount", "type": "number", "default": null },
        "hide_automatic_feedbacks": { "label": "Hide Automatic Feedbacks", "type": "toggle", "default": false }
      }
    },
    "text-block": {
      "label": "Text",
      "multiple": true,
      "properties": {
        "title": { "label": "Title", "type": "text", "default": "Text Block" },
        "text": { "label": "Text", "type": "textarea", "default": "This is a text block." },
        "buttons": {
          "label": "Buttons",
          "type": "list",
          "maxItems": 4,
          "properties": {
            "text": { "label": "Text", "type": "text", "default": "Shop Now" },
            "icon": { "label": "Icon", "type": "icon" },
            "link": { "label": "Link", "type": "text", "default": "/products" },
            "new_tab": { "label": "Open in New Tab", "type": "toggle", "default": false }
          },
          "default": [{ "text": "Shop Now", "icon": "fas fa-shopping-cart", "link": "/products", "new_tab": false, "color": "primary" }]
        },
        "show_background": { "label": "Show Background", "type": "toggle", "default": false },
        "title_alignment": { "label": "Title Alignment", "type": "select", "options": ["left","center","right"], "default": "left" },
        "content_alignment": { "label": "Content Alignment", "type": "select", "options": ["left","center","right"], "default": "left" }
      }
    },
    "text-image-block": {
      "label": "Text & Image",
      "multiple": true,
      "properties": {
        "title": { "label": "Title", "type": "text", "default": "Text & Image Block" },
        "text": { "label": "Text", "type": "textarea", "default": "This is a text & image block." },
        "image": { "label": "Image", "type": "image" },
        "buttons": {
          "label": "Buttons", "type": "list", "maxItems": 4,
          "properties": {
            "text": { "label": "Text", "type": "text", "default": "Shop Now" },
            "icon": { "label": "Icon", "type": "icon" },
            "link": { "label": "Link", "type": "text", "default": "/products" },
            "new_tab": { "label": "Open in New Tab", "type": "toggle", "default": false }
          },
          "default": [{ "text": "Shop Now", "icon": "fas fa-shopping-cart", "link": "/products", "new_tab": false, "color": "primary" }]
        },
        "aspect_ratio": { "label": "Aspect Ratio", "type": "select", "options": ["Default","1/1","4/3","16/9"], "default": "16/9" },
        "show_background": { "label": "Show Background", "type": "toggle", "default": false },
        "title_alignment": { "label": "Title Alignment", "type": "select", "options": ["left","center","right"], "default": "left" },
        "content_alignment": { "label": "Content Alignment", "type": "select", "options": ["left","center","right"], "default": "left" }
      }
    },
    "text-video-block": {
      "label": "Text & Video",
      "multiple": true,
      "properties": {
        "title": { "label": "Title", "type": "text", "default": "Text & Video Block" },
        "text": { "label": "Text", "type": "textarea", "default": "This is a text & video block." },
        "video_link": { "label": "YouTube Video Link", "type": "text" },
        "buttons": {
          "label": "Buttons", "type": "list", "maxItems": 4,
          "properties": {
            "text": { "label": "Text", "type": "text", "default": "Shop Now" },
            "icon": { "label": "Icon", "type": "icon" },
            "link": { "label": "Link", "type": "text", "default": "/products" },
            "new_tab": { "label": "Open in New Tab", "type": "toggle", "default": false }
          },
          "default": []
        },
        "show_background": { "label": "Show Background", "type": "toggle", "default": false },
        "title_alignment": { "label": "Title Alignment", "type": "select", "options": ["left","center","right"], "default": "left" },
        "content_alignment": { "label": "Content Alignment", "type": "select", "options": ["left","center","right"], "default": "left" }
      }
    },
    "image-gallery": {
      "label": "Image Gallery",
      "multiple": true,
      "properties": {
        "title": { "label": "Title", "type": "text", "default": "Gallery" },
        "items_per_row": { "label": "Items per row", "type": "select", "options": [1,2,3,4], "default": 2 },
        "aspect_ratio": { "label": "Aspect Ratio", "type": "select", "options": ["Default","1/1","4/3","16/9"], "default": "16/9" },
        "images": { "type": "image", "maxImages": 50, "default": [] }
      }
    },
    "video-gallery": {
      "label": "Video Gallery",
      "multiple": true,
      "properties": {
        "title": { "label": "Title", "type": "text", "default": "Gallery" },
        "items_per_row": { "label": "Items per row", "type": "select", "options": [1,2,3,4], "default": 2 },
        "videos": {
          "label": "Videos", "type": "list", "maxItems": 10,
          "properties": {
            "link": { "label": "YouTube Video Link", "type": "text" },
            "aspect_ratio": { "label": "Aspect Ratio", "type": "select", "options": ["16/9","9/16"], "default": "16/9" }
          }
        }
      }
    },
    "faq": {
      "label": "FAQ",
      "multiple": true,
      "properties": {
        "title": { "label": "Title", "type": "text", "default": "Frequently Asked Questions" },
        "items": {
          "label": "Items", "type": "list", "maxItems": 20,
          "properties": {
            "question": { "label": "Question", "type": "text", "default": "New Question" },
            "answer": { "label": "Answer", "type": "textarea", "default": "New Answer" }
          },
          "default": [{ "question": "What is this?", "answer": "This is a FAQ item." }]
        }
      }
    },
    "myvouches": {
      "label": "MyVouches",
      "multiple": true,
      "properties": {
        "title": { "label": "Title", "type": "text", "default": "Our Vouches" },
        "username": { "label": "Username", "type": "text" },
        "title_alignment": { "label": "Title Alignment", "type": "select", "options": ["left","center","right"], "default": "left" }
      }
    },
    "blog-posts": {
      "label": "Blog Posts",
      "multiple": false,
      "templates": ["shop","blog"],
      "properties": {
        "title": { "label": "Title", "type": "text", "default": "Our Blog" },
        "amount": { "label": "Amount", "type": "number" },
        "centered": { "label": "Center Posts", "type": "toggle", "default": false }
      }
    },
    "footer": {
      "label": "Footer",
      "global": true,
      "order": -1,
      "properties": {
        "show_shop_name": { "label": "Show Shop Name", "type": "toggle", "default": true },
        "show_logo": { "label": "Show Logo", "type": "toggle", "default": true },
        "show_socials": { "label": "Show Socials", "type": "toggle", "default": true },
        "copyright": { "label": "Copyright", "type": "textarea", "default": "Copyright © {{ shop.name }} {{ '' | currentYear }}" },
        "links": {
          "label": "Links", "type": "list", "maxItems": 10,
          "properties": {
            "text": { "label": "Text", "type": "text", "default": "New Link" },
            "link": { "label": "Link", "type": "text", "default": "#" },
            "new_tab": { "label": "Open in New Tab", "type": "toggle", "default": false }
          },
          "default": [
            { "text": "Terms of Service", "link": "/terms-of-service", "new_tab": false },
            { "text": "Privacy Policy", "link": "/privacy-policy", "new_tab": false },
            { "text": "Refund Policy", "link": "/refund-policy", "new_tab": false }
          ]
        }
      }
    },
    "cart-page": { "label": "Cart Page", "page": true, "templates": ["cart"], "properties": {} },
    "products-page": {
      "label": "Products Page", "page": true, "templates": ["products"],
      "properties": {
        "default_title": { "label": "Default Title", "type": "text", "default": "Our Products" },
        "category_title": { "label": "Category Title", "type": "text", "default": "{{ category.name }} Products" }
      }
    },
    "product-page": {
      "label": "Product Page", "page": true, "templates": ["product"],
      "properties": {
        "variant_selector": { "label": "Variant Selector", "type": "select", "options": ["buttons","dropdown"], "default": "buttons" },
        "hide_add_to_cart": { "label": "Hide Add to Cart Button", "type": "toggle", "default": false },
        "hide_buy_now": { "label": "Hide Buy Now Button", "type": "toggle", "default": false }
      }
    },
    "status-page": {
      "label": "Status Page", "page": true, "templates": ["status"],
      "properties": { "title": { "label": "Title", "type": "text", "default": null } }
    },
    "terms-page": {
      "label": "Terms Page", "page": true, "templates": ["terms"],
      "properties": { "title": { "label": "Title", "type": "text", "default": "Terms of Service" } }
    },
    "privacy-policy-page": {
      "label": "Privacy Policy Page", "page": true, "templates": ["privacy-policy"],
      "properties": { "title": { "label": "Title", "type": "text", "default": "Privacy Policy" } }
    },
    "refund-policy-page": {
      "label": "Refund Policy Page", "page": true, "templates": ["refund-policy"],
      "properties": { "title": { "label": "Title", "type": "text", "default": "Refund Policy" } }
    },
    "blog-post-page": { "label": "Blog Post", "page": true, "templates": ["blog-post"], "properties": {} }
  }
}
