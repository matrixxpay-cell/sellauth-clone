<a
  class="lb-product-card"
  href="{{ 'javascript:void(0);' if product.type == 'group' else (('/product/' + product.path) | shopUrl) }}"
  @click="{{ 'openGroupModal(' ~ product.id ~ ')' if product.type == 'group' else '' }}"
>
  <!-- Image -->
  <div class="lb-card-image-wrap">
    {% if product.image_urls|length > 0 %}
      <img src="{{ product.image_urls[0] }}" class="lb-card-image {{ 'aspect-group-card-image object-group-image' if product.type == 'group' else 'aspect-product-card-image object-product-image' }}" loading="lazy" />
    {% elif product.image_url %}
      <img src="{{ product.image_url }}" class="lb-card-image {{ 'aspect-group-card-image object-group-image' if product.type == 'group' else 'aspect-product-card-image object-product-image' }}" loading="lazy" />
    {% else %}
      <div class="lb-card-image-placeholder {{ 'aspect-group-card-image' if product.type == 'group' else 'aspect-product-card-image' }}">
        <svg xmlns="http://www.w3.org/2000/svg" class="lb-placeholder-icon" viewBox="0 0 256 256">
          <path fill="currentColor" d="m222.72 67.91l-88-48.18a13.9 13.9 0 0 0-13.44 0l-88 48.18A14 14 0 0 0 26 80.18v95.64a14 14 0 0 0 7.28 12.27l88 48.18a13.92 13.92 0 0 0 13.44 0l88-48.18a14 14 0 0 0 7.28-12.27V80.18a14 14 0 0 0-7.28-12.27ZM127 30.25a2 2 0 0 1 1.92 0L212.51 76l-33.94 18.57l-84.52-46.26ZM122 223l-83-45.43a2 2 0 0 1-1-1.75V86.66l84 46ZM43.49 76l38.07-20.85l84.51 46.26L128 122.24ZM218 175.82a2 2 0 0 1-1 1.75L134 223v-90.36l36-19.71V152a6 6 0 0 0 12 0v-45.63l36-19.71Z"/>
        </svg>
      </div>
    {% endif %}

    <!-- Badges -->
    {% if product.product_badges.card|length > 0 %}
    <div class="lb-card-badges">
      {% for badge in product.product_badges.card %}
      <span class="lb-badge" style="background-color: {{ badge.color }}">
        {% if badge.icon %}<i class="{{ badge.icon }} fa-fw"></i>{% endif %}
        {{ badge.label }}
      </span>
      {% endfor %}
    </div>
    {% endif %}

    <!-- Stock overlay -->
    {% if product.stock === 0 %}
    <div class="lb-sold-out">Sold Out</div>
    {% endif %}
  </div>

  <!-- Info -->
  <div class="lb-card-body">
    <h3 class="lb-card-title">{{ product.name }}</h3>

    <div class="lb-card-stock">
      {% if product.type == 'group' %}
        <span>{{ product.products | length }} Products</span>
      {% elif product.stock === 0 %}
        <span class="lb-stock-out">Out of Stock</span>
      {% elif product.hide_stock_count %}
        <span class="lb-stock-in">In Stock</span>
      {% elif product.stock === -1 %}
        <span class="lb-stock-in">
          <svg xmlns="http://www.w3.org/2000/svg" class="lb-icon-xs" fill="currentColor" viewBox="0 0 256 256"><path d="M248,128a56,56,0,0,1-95.6,39.6l-.33-.35L92.12,99.55a40,40,0,1,0,0,56.9l8.52-9.62a8,8,0,1,1,12,10.61l-8.69,9.81-.33.35a56,56,0,1,1,0-79.2l.33.35,59.95,67.7a40,40,0,1,0,0-56.9l-8.52,9.62a8,8,0,1,1-12-10.61l8.69-9.81.33-.35A56,56,0,0,1,248,128Z"/></svg>
          In Stock
        </span>
      {% else %}
        <span class="lb-stock-in">{{ product.stock }} In Stock</span>
      {% endif %}
    </div>

    <div class="lb-card-price">
      <span class="lb-price-accent">
        {% if product.min_price != product.max_price %}
          <span x-text="appCurrency.format({{ product.min_price }}, '{{ product.currency }}')">{{ formatPrice(product.min_price, product.currency) }}</span>
          &ndash;
          <span x-text="appCurrency.format({{ product.max_price }}, '{{ product.currency }}')">{{ formatPrice(product.max_price, product.currency) }}</span>
        {% elif product.min_price %}
          <span x-text="appCurrency.format({{ product.min_price }}, '{{ product.currency }}')">{{ formatPrice(product.min_price, product.currency) }}</span>
        {% else %}
          &mdash;
        {% endif %}
      </span>
      {% if product.min_price_slash %}
        <span class="lb-price-slash">
          <span x-text="appCurrency.format({{ product.min_price_slash }}, '{{ product.currency }}')">{{ formatPrice(product.min_price_slash, product.currency) }}</span>
        </span>
      {% endif %}
    </div>
  </div>
</a>
