<div x-show="appTickets.showCreateModal" x-cloak class="lb-modal-overlay">
  <div class="lb-modal-backdrop" @click="appTickets.closeCreateModal()"></div>
  <div class="lb-modal-wrap lb-modal-wrap--sm">
    <div class="lb-modal">
      <div class="lb-modal-header">
        <h3 class="lb-modal-title">Create Support Ticket</h3>
        <button @click="appTickets.closeCreateModal()" class="lb-modal-close">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="lb-icon"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
        </button>
      </div>
      <div class="lb-modal-body">
        <form @submit.prevent="appTickets.createTicket()" class="lb-form">
          <div class="lb-form-group">
            <label class="lb-label">Subject</label>
            <input x-model="appTickets.subject" type="text" class="lb-input" required />
          </div>
          <div class="lb-form-group">
            <label class="lb-label">Message</label>
            <textarea x-model="appTickets.message" class="lb-input lb-textarea" rows="4" required></textarea>
          </div>
          <button type="submit" class="lb-btn lb-btn--primary lb-btn--full" :disabled="appTickets.loading">Submit</button>
        </form>
      </div>
    </div>
  </div>
</div>
